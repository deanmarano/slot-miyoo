+mod common;
+
+/// The lockup this exists to prevent: mid-game, `compose` waited 1.5 seconds
+/// for a cart face on the handheld, because launching a game reorders the
+/// Recents shelf and the face workers are the only hot threads with no
+/// priority. Nothing of the shelf is drawn then, so nothing is asked for
+/// beyond the seated cart, and nothing is marked on-screen for `sync` to block
+/// the frame loop on.
+#[test]
+fn a_playing_game_asks_for_almost_nothing_and_blocks_on_none_of_it() {
+    let d = common::tmp_root_with_carts(&["Emerald", "Ruby", "Sapphire", "FireRed"]);
+    let mut app = common::app_playing_in(d.path(), "Emerald");
+    assert!(app.playing_only(), "the test did not reach Playing");
+
+    let wants = app.face_wants();
+    assert!(
+        wants.len() <= 1,
+        "a game is playing; {} faces were asked for",
+        wants.len()
+    );
+    assert!(
+        wants.iter().all(|w| !w.on_screen),
+        "nothing is on screen while a game is playing, so nothing may be waited for"
+    );
+
+    // And what is already held is shed down to the seated cart. The shelf
+    // index comes from the want rather than being assumed: shelf 0 is Recents.
+    let shelf = wants[0].shelf;
+    for i in 0..4 {
+        app.set_cart_face(shelf, i, TexId::from_raw(i + 1));
+    }
+    assert!(
+        app.shed_faces().len() >= 3,
+        "faces for carts that cannot be seen should not survive a launch"
+    );
+}
