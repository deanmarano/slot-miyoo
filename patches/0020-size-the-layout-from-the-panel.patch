+
+enum Axis {
+    Row,
+    Column,
+}
+
+/// Ping-pong an index into a band: 0, 1, .. n-1, n-1, .. 1, 0, 0, ..
+fn mirror(i: usize, band: usize) -> usize {
+    let band = band.max(1);
+    let period = band * 2;
+    let at = i % period;
+    match at < band {
+        true => at,
+        false => period - 1 - at,
+    }
+}
+
+/// How many rows (or columns) at the edge are as flat as the outermost one.
+///
+/// Each line is compared with the one before it, not with the outermost one.
+/// The plastic is subtly lit across the art, so measuring against line 0
+/// measures that gradient and stops the band in the middle of flat plastic. A
+/// gradient steps gently and an edge jumps: 1% of the plastic's own brightness
+/// tells them apart, and the spread test catches a change of texture that
+/// brightness alone would miss.
+fn plain_band(art: &[u8], aw: usize, ah: usize, axis: Axis) -> usize {
+    let len = match axis {
+        Axis::Row => ah,
+        Axis::Column => aw,
+    };
+    let stat = |i: usize| -> (f32, f32) {
+        let n = match axis {
+            Axis::Row => aw,
+            Axis::Column => ah,
+        };
+        let at = |k: usize| match axis {
+            Axis::Row => (i * aw + k) * 4,
+            Axis::Column => (k * aw + i) * 4,
+        };
+        let lum = |p: usize| (art[p] as f32 + art[p + 1] as f32 + art[p + 2] as f32) / 3.0;
+        let mean = (0..n).map(|k| lum(at(k))).sum::<f32>() / n as f32;
+        let var = (0..n).map(|k| (lum(at(k)) - mean).powi(2)).sum::<f32>() / n as f32;
+        (mean, var.sqrt())
+    };
+    let (mean0, sd0) = stat(0);
+    let (mut prev, mut band) = (mean0, 1);
+    while band < len {
+        let (mean, sd) = stat(band);
+        if (mean - prev).abs() > mean0 * 0.01 || sd > sd0 * 1.5 + 0.5 {
+            break;
+        }
+        prev = mean;
+        band += 1;
+    }
+    band
 }
 
