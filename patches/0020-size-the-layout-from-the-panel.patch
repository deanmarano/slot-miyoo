+        let mut px = vec![0u8; w * h * 4];
+        for y in 0..h {
+            for x in 0..w {
+                let inside = x > 12 && x < w - 12 && y > 12 && y < h - 12;
+                let v = if inside { 200 } else { 60 };
+                px[(y * w + x) * 4..][..4].copy_from_slice(&[v, v, v, 255]);
