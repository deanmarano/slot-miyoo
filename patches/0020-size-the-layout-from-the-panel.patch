+    /// The bug this exists for: a 427-tall art on a 480 panel leaves 26 rows
+    /// above and 27 below, and reading the art's extent as `ph - 1 - oy` took
+    /// a row the art never wrote -- black -- and mirrored it into the plastic.
+    #[test]
+    fn an_odd_margin_leaves_no_unwritten_line() {
+        let (aw, ah, pw, ph) = (640, 427, 640, 480);
+        let out = fill_panel(&art(aw, ah), (aw, ah), (pw, ph));
+        assert_eq!(out.len(), (pw * ph * 4) as usize);
+        for y in 0..ph as usize {
+            let row = &out[y * pw as usize * 4..][..pw as usize * 4];
+            assert!(
