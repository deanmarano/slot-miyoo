+const KEY_VOLUMEDOWN: u16 = 114;
+const KEY_VOLUMEUP: u16 = 115;
+
+/// Whether any input node advertises the volume keys.
+///
+/// The Miyoo Mini has a volume *wheel*, an analogue pot on the amplifier, and
+/// no KEY_VOLUMEUP/KEY_VOLUMEDOWN at all -- its capability bitmap carries the
+/// other sixteen keys this port maps and not those two. slot's own volume is
+/// then a level nothing on the device can raise, so it is taken out of the way
+/// and the wheel is left to do the work. See `device_app`.
+pub fn advertises_volume_keys(sys: &Path) -> bool {
+    let Ok(entries) = std::fs::read_dir(sys) else {
+        return true;
+    };
+    entries
+        .filter_map(|e| e.ok())
+        .map(|e| e.path())
+        .filter(|p| {
+            p.file_name()
+                .is_some_and(|n| n.to_string_lossy().starts_with("event"))
+        })
+        .any(|node| {
+            let keys =
+                std::fs::read_to_string(node.join("device/capabilities/key")).unwrap_or_default();
+            has_bit(&keys, KEY_VOLUMEUP) || has_bit(&keys, KEY_VOLUMEDOWN)
+        })
+}
