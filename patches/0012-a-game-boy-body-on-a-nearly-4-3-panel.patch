+/// Whether this panel gets the Game Boy body drawn around the picture.
+///
+/// Near enough to 4:3 rather than exactly it. The Mini Flip's 752x560 is
+/// 0.71% off -- 2256 against 2240, sixteen pixels -- and exact equality turned
+/// the frame off for a panel nobody would call anything but 4:3. The window
+/// is 1/64, wide enough for a panel whose maker rounded to a round number and
+/// narrow enough that 16:9 and 3:2 stay out.
 pub fn framed(panel: (u32, u32)) -> bool {
-    panel.0 > 0 && panel.0 * 3 == panel.1 * 4
+    if panel.0 == 0 || panel.1 == 0 {
+        return false;
+    }
+    let (a, b) = (u64::from(panel.0) * 3, u64::from(panel.1) * 4);
+    let (lo, hi) = (a.min(b), a.max(b));
+    hi - lo <= hi / 64
 }
 
 pub fn screen_rect(panel: (u32, u32)) -> (i32, i32, i32, i32) {
