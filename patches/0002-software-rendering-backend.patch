+        let (x, y, w, h) = screen_rect(1.0, PICTURE);
+        assert_eq!((w, h), (GAME_W as f32, GAME_H as f32));
+        assert_eq!(x, (OUT_W as f32 - GAME_W as f32) / 2.0);
+        assert_eq!(y, (OUT_H as f32 - GAME_H as f32) / 2.0);
+    }
+
+    /// The bug this flag exists for: with the canvas at 752x560 and the
+    /// picture left at 720x480, "stretch" filled everything except a 16px
+    /// border down each side and 40px top and bottom.
+    #[test]
+    fn the_stretched_picture_fills_the_canvas() {
+        let (x, y, w, h) = screen_rect(1.0, [OUT_W as f32, OUT_H as f32]);
+        assert_eq!((x, y), (0.0, 0.0));
+        assert_eq!((w, h), (OUT_W as f32, OUT_H as f32));
