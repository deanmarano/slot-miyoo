     pub fn sync(&mut self, app: &mut App, compositor: &mut Compositor) {
         self.free.extend(app.shed_faces());
+        // The free list is a recycling bin, not a release: a shed face is held
+        // until something else happens to want a texture. That is the right
+        // trade on the shelf, where another face is wanted a moment later, and
+        // the wrong one in play, where nothing is -- and where the memory is
