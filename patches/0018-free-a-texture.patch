+        let next = c.create_texture(8, 8, &pixels(8));
+        assert_eq!(
+            next.raw(),
+            big.raw(),
+            "a new texture did not reuse the hole"
+        );
+        assert_eq!(c.textures.len(), before, "the table grew past the hole");
