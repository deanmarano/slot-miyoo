+    /// Give a texture's memory back; the slot is reused by the next create.
+    /// The software backend's note says why this exists.
+    pub fn free_texture(&mut self, id: TexId) {
+        let Some(tex) = self.textures.get_mut(id.0) else {
+            return;
+        };
+        if *tex != 0 {
+            unsafe { gl::DeleteTextures(1, tex) };
+            *tex = 0;
+        }
+    }
+
     fn push(&mut self, w: u32, h: u32, rgba: &[u8], filter: gl::types::GLenum) -> TexId {
         let tex = crate::gl::texture(w, h, filter, gl::CLAMP_TO_EDGE, gl::RGBA, Some(rgba));
+        if let Some(id) = self.textures.iter().position(|t| *t == 0) {
+            self.textures[id] = tex;
+            return TexId(id);
+        }
         self.textures.push(tex);
         TexId(self.textures.len() - 1)
     }
