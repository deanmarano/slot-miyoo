+    /// Freeing hands the bytes back, rather than parking them on a list to be
+    /// recycled later: that difference is why a GBA cart was being OOM-killed.
+    #[test]
+    fn a_freed_texture_gives_its_bytes_back_and_its_slot() {
+        let mut c = Compositor::new(&NoSurface).expect("compositor");
+        let big = c.create_texture(64, 64, &pixels(64));
+        let before = c.textures.len();
+        c.free_texture(big);
+        assert!(
+            c.textures[big.raw()].is_none(),
+            "the texture is still holding its image"
+        );
+
