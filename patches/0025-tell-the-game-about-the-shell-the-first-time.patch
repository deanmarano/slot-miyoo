+mod sp_frame_tests {
+    use super::*;
+
+    /// Booting straight into a GBA cart: the first thing the compositor hears
+    /// about the shell is `set_sp_frame(true)`, and the picture has to sit at
+    /// the top of the panel under the shell's opening rather than centred in
+    /// it. Fails against the old code with the picture 26 rows down, which is
+    /// where the chin starts eating it.
+    #[test]
+    fn the_first_word_about_the_shell_reaches_the_game() {
+        struct NoSurface;
+        impl Surface for NoSurface {
+            fn make_current(&mut self) -> Result<(), crate::surface::GfxError> {
+                Ok(())
+            }
+            fn window_size(&self) -> (u32, u32) {
+                (out_w(), out_h())
+            }
+            fn swap(&mut self) -> Result<(), crate::surface::GfxError> {
+                Ok(())
+            }
+            fn proc_address(&self, _name: &str) -> *const std::ffi::c_void {
+                std::ptr::null()
+            }
+        }
+        let mut c = Compositor::new(&NoSurface).expect("compositor");
+        c.set_sp_frame(true);
+        let (_, y, _, h) = c.game.rect();
+        assert_eq!(y, 0.0, "the picture is {y} down, not under the opening");
+        assert!(h > 0.0);
+    }
