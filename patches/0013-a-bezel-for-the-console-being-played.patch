+#[cfg(test)]
+mod game_bezel_tests {
+    use super::Game;
+    use crate::pipeline::{SRC_H, SRC_W};
+    use crate::surface::{OUT_H, OUT_W};
+
+    /// The transparent hole in `assets/bezel_gb.png` and `assets/bezel_gbc.png`,
+    /// measured off both files: 478x429 at (121, 27) of 720x480. The art is
+    /// drawn at the picture's frame, so the hole lands at the frame's offset
+    /// in the panel plus this.
+    const HOLE: (f32, f32, f32, f32) = (121.0, 27.0, 478.0, 429.0);
+
+    /// A Game Boy picture inside the 240x160 texture, as `App::picture_rect`
+    /// gives it: bounds, not a rect.
+    fn gb() -> Game {
+        let mut g = Game::new();
+        let (w, h) = (160.0, 144.0);
+        let (sw, sh) = (SRC_W as f32, SRC_H as f32);
+        let (x, y) = ((sw - w) / 2.0, (sh - h) / 2.0);
+        g.pic = [x / sw, y / sh, (x + w) / sw, (y + h) / sh];
+        g.crop = true;
+        g
+    }
+
+    /// Cropped, the game pass draws the 160x144 picture at 3x and no paper:
+    /// the band the bezel covers is left for the surround to paint.
+    #[test]
+    fn a_cropped_game_draws_the_picture_alone() {
+        let (x, y, w, h) = gb().rect();
+        // Within a float's worth of 480x432: the crop is a ratio of the
+        // texture, not a count of pixels.
+        assert!(
+            (w - 480.0).abs() < 0.01 && (h - 432.0).abs() < 0.01,
+            "{w}x{h}"
+        );
+        assert!(
+            (x - (OUT_W as f32 - w) / 2.0).abs() < 0.01
+                && (y - (OUT_H as f32 - h) / 2.0).abs() < 0.01,
+            "at {x},{y}"
+        );
+    }
+
+    /// And it lands in the hole. Nothing lines these two up at run time -- the
+    /// art is one file and the crop is arithmetic -- so a change to either that
+    /// leaves paper showing, or clips the picture, is caught here.
+    #[test]
+    fn the_picture_fills_the_hole_in_the_art() {
+        let g = gb();
+        let (px, py, pw, ph) = g.rect();
+        let (fx, fy, _, _) = g.rect_of(g.base);
+        let (hx, hy, hw, hh) = (fx + HOLE.0, fy + HOLE.1, HOLE.2, HOLE.3);
+        // The picture covers the hole, by a few pixels of the art's own dark
+        // inner edge at most: never short of it, which would show paper.
+        for (edge, got, want) in [
+            ("left", px, hx),
+            ("top", py, hy),
+            ("right", hx + hw, px + pw),
+            ("bottom", hy + hh, py + ph),
+        ] {
+            let over = want - got;
+            assert!(
+                (0.0..=4.0).contains(&over),
+                "{edge}: picture {px},{py} {pw}x{ph} against hole {hx},{hy} {hw}x{hh}"
+            );
+        }
+    }
+
+    /// The whole frame is still what a still is drawn at, and what the bezel
+    /// itself is drawn at: 720x480, paper included.
+    #[test]
+    fn the_frame_keeps_its_own_size() {
+        let g = gb();
+        let (_, _, w, h) = g.rect_of(g.base);
+        assert_eq!((w, h), (crate::power::PICTURE[0], crate::power::PICTURE[1]));
+    }
+}
