 #[cfg(test)]
+mod blue_light_tests {
+    use super::*;
+
+    /// A frame with nothing but the game in it takes the direct path, which
+    /// writes to the panel and leaves the canvas alone. Blue light turns that
+    /// path off -- and the game then has to reach the canvas, or the panel
+    /// shows the surround over a blank screen.
+    ///
+    /// Reported from a Mini Plus as "black, or just the shaders".
+    #[test]
+    fn the_game_still_reaches_the_panel_with_blue_light_on() {
+        let (pw, ph) = (out_w(), out_h());
+        let mut panel = vec![0u8; pw as usize * ph as usize * 4];
+        let target = fb::Target {
+            ptr: panel.as_mut_ptr(),
+            w: pw,
+            h: ph,
+            stride: pw as usize * 4,
+            bgr: true,
+        };
+        // SAFETY: `panel` outlives the frame drawn into it.
+        unsafe { fb::set_current_for_test(Some(target)) };
+
+        struct NoSurface;
+        impl Surface for NoSurface {
+            fn make_current(&mut self) -> Result<(), crate::surface::GfxError> {
+                Ok(())
+            }
+            fn window_size(&self) -> (u32, u32) {
+                (out_w(), out_h())
+            }
+            fn swap(&mut self) -> Result<(), crate::surface::GfxError> {
+                Ok(())
+            }
+            fn proc_address(&self, _name: &str) -> *const std::ffi::c_void {
+                std::ptr::null()
+            }
+        }
+        let mut c = Compositor::new(&NoSurface).expect("compositor");
+        let mut frame = vec![0u8; (SRC_W * SRC_H * 4) as usize];
+        for (i, px) in frame.chunks_exact_mut(4).enumerate() {
+            px.copy_from_slice(&[200, 180, 160, 255]);
+            let _ = i;
+        }
+        c.upload_game(&frame);
+        c.set_blue_light(crate::grade::BLUE_LIGHT_MAX);
+        c.begin_frame();
+        c.draw_list(&[Draw::Game]);
+        c.end_frame((pw, ph));
+
+        // SAFETY: clearing the pointer before `panel` is dropped.
+        unsafe { fb::set_current_for_test(None) };
+        let lit = panel
+            .chunks_exact(4)
+            .filter(|p| p[0] > 8 || p[1] > 8)
+            .count();
+        assert!(
+            lit > (pw * ph / 8) as usize,
+            "the panel came out blank: {lit} lit pixels of {}",
+            pw * ph
+        );
+    }
+}
