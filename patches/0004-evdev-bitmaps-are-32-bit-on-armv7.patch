+#[cfg(test)]
+mod miyoo_bitmap_tests {
+    use super::has_bit_in_words;
+
+    /// The Mini Flip's `soc:gpio_keys` capability bitmap, as the device prints
+    /// it. Four words for a 32-bit kernel; read as 64-bit it is nonsense.
+    const GPIO_KEYS: &str = "1c1682 0 3000400 3014c002";
+
+    fn has(bit: u16) -> bool {
+        has_bit_in_words(GPIO_KEYS, bit, 32)
+    }
+
+    #[test]
+    fn finds_every_button_the_device_advertises() {
+        // The 18 keys the probe decoded, cross-checked against Allium's map.
+        for bit in [
+            1, 14, 15, 18, 20, 28, 29, 42, 56, 57, 97, 103, 105, 106, 108, 114, 115, 116,
+        ] {
+            assert!(has(bit), "missed bit {bit}");
+        }
+    }
+
+    #[test]
+    fn does_not_invent_buttons() {
+        // Gamepad codes: this device has none of them.
+        for bit in [0x130, 0x131, 0x133, 0x13a] {
+            assert!(!has(bit), "invented bit {bit:#x}");
+        }
+        // Neighbours of real bits, to catch an off-by-one in the word maths.
+        for bit in [2, 13, 16, 58, 102, 117] {
+            assert!(!has(bit), "invented bit {bit}");
+        }
+    }
+
+    #[test]
+    fn reading_a_32_bit_mask_as_64_loses_the_keyboard_range() {
+        // The bug this replaced: KEY_SPACE is the A button on every Miyoo.
+        assert!(has(57));
+        assert!(!has_bit_in_words(GPIO_KEYS, 57, 64));
+    }
+}
