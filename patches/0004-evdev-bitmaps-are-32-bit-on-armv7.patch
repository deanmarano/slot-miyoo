+/// The Miyoo Mini Flip has no `/sys/class/power_supply` at all. Its charge is
+/// behind a vendor tool, which prints one line of JSON:
+///
+/// ```text
+/// {"battery":93, "voltage":4026, "charging":0}
+/// ```
+///
+/// Allium reads the same tool on this hardware. Spawning a process to read a
+/// battery is not lovely, but it is the only source there is, and it is read
+/// rarely -- the alternative is the SAR ADC behind `/dev/sar` and a pair of
+/// vendor ioctls, which is a lot of machinery for the same number.
+const AXP_TOOL: &str = "/customer/app/axp_test";
+
+fn axp_battery() -> Option<Battery> {
+    if !Path::new(AXP_TOOL).is_file() {
+        return None;
+    }
+    let out = std::process::Command::new(AXP_TOOL).output().ok()?;
+    let text = String::from_utf8_lossy(&out.stdout);
+
+    // Deliberately not a JSON parser: one flat object of integers, and a
+    // dependency for this would be absurd.
+    let field = |name: &str| -> Option<i64> {
+        let at = text.find(&format!("\"{name}\""))?;
+        let rest = &text[at + name.len() + 2..];
+        let start = rest.find(|c: char| c == '-' || c.is_ascii_digit())?;
+        let rest = &rest[start..];
+        let end = rest
+            .find(|c: char| !(c == '-' || c.is_ascii_digit()))
+            .unwrap_or(rest.len());
+        rest[..end].parse().ok()
+    };
+
+    let percent = field("battery")?.clamp(0, 100) as u8;
+    let charge = match field("charging") {
+        Some(0) => Charge::Discharging,
+        Some(_) => Charge::Charging,
+        None => Charge::Unknown,
+    };
+    Some(Battery { percent, charge })
+}
