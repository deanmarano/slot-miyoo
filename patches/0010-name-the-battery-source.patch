+#[test]
+fn the_report_names_the_battery_source_rather_than_denying_it() {
+    // No power_supply at all is this device's normal state; the report should
+    // not then say "no battery", because the vendor tool is the source and the
+    // indicator works. Only reachable where the tool exists, so this asserts
+    // the absent case and documents the other.
+    let d = pwm_sysfs("800");
+    let p = platform(&d);
+    let report = p.report();
+    assert!(report.contains("backlight pwm"), "{report}");
+    if std::path::Path::new("/customer/app/axp_test").is_file() {
+        assert!(report.contains("battery axp_test"), "{report}");
+    } else {
+        assert!(report.contains("battery no battery"), "{report}");
+    }
+}
