+#[cfg(test)]
+mod plan_tests {
+    use super::*;
+
+    /// The state sizes this runs into: a GBA state from mGBA, and a Game Boy
+    /// one, both as the cores report them.
+    const GBA: usize = 425_984;
+    const GB: usize = 24_576;
+
+    #[test]
+    fn a_gba_state_is_recorded_far_less_often_than_a_game_boy_one() {
+        let (gba, gb) = (plan(GBA), plan(GB));
+        assert_eq!(gb.every, 2, "a small state keeps upstream's interval");
+        assert!(
+            gba.every >= 8,
+            "a GBA state at every {} frames is {} MB/s of copy, xor and lz4",
+            gba.every,
+            GBA * 60 / gba.every as usize / 1024 / 1024
+        );
+    }
+
+    /// The rate is the point: whatever the state size, the traffic this makes
+    /// stays near RATE rather than scaling with the console.
+    #[test]
+    fn the_byte_rate_stays_bounded_across_state_sizes() {
+        for len in [GB, 64 * 1024, 128 * 1024, GBA, 1024 * 1024] {
+            let p = plan(len);
+            let rate = len * 60 / p.every as usize;
+            assert!(
+                rate <= RATE * 2,
+                "{len} byte state makes {rate} B/s at every {} frames",
+                p.every
+            );
+        }
+    }
+
+    #[test]
+    fn the_budget_holds_states_rather_than_megabytes() {
+        assert_eq!(plan(GB).budget, BUDGET_MIN, "a small state hits the floor");
+        assert!(plan(GBA).budget <= BUDGET_MAX);
+        assert!(
+            plan(GBA).budget >= GBA * 8,
+            "a GBA budget that holds fewer than eight states is not a rewind"
+        );
+        assert!(plan(usize::MAX).budget <= BUDGET_MAX, "no overflow");
+    }
+
+    /// Shrinking the ring under what it already holds drops the oldest, and
+    /// the accounting stays straight.
+    #[test]
+    fn a_smaller_budget_drops_the_oldest_deltas() {
+        let mut r = Rewind::new(BUDGET_MAX);
+        let mut state = vec![0u8; 4096];
+        for i in 0..32u8 {
+            state[i as usize % 4096] = i;
+            r.push(&state);
+        }
+        let before = r.bytes;
+        assert!(before > 0, "nothing was recorded");
+        r.set_budget(before / 2);
+        assert!(r.bytes <= before / 2, "the ring did not shrink");
+        assert!(r.pop().is_some(), "what is left is still usable");
+    }
+}
