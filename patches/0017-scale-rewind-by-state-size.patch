 pub const REWIND_BYTES: usize = 20 * 1024 * 1024;
 
+/// How often to snapshot, and how much to keep, for a state of this size.
+///
+/// Upstream snapshots every two frames into a 20 MB ring. For a GBA state of
+/// 425,984 bytes that is thirty pushes a second, and each push copies the
+/// state, XORs it against the last one and LZ4s the result: about 13 MB/s of
+/// memory traffic on a 1.2 GHz Cortex-A7, beside the emulator it is supposed
+/// to be recording. The ring then fills 20 MB of a 101 MB device in well under
+/// a minute. Both halves were reported from the handheld as the same symptom
+/// -- "works for a little bit, then major slowdown, then crash" -- and the
+/// crash was the OOM killer.
+///
+/// So both scale with the state. A Game Boy state is some thirty times smaller
+/// than a GBA one and costs proportionally less, which is why upstream's
+/// numbers are fine there and ruinous here: the interval holds the byte rate
+/// near `RATE`, and the budget holds a fixed number of states rather than a
+/// fixed number of megabytes.
+///
+///   - GBA, 425,984 bytes: every 9 frames (6.7 a second) and 6.5 MB
+///   - Game Boy, ~24 KB:   every 2 frames, upstream's, and the 2 MB floor
+///
+/// The floor matters more than it looks: deltas of a small state compress to
+/// very little, so 2 MB of them is a long way back.
+pub struct Plan {
+    pub budget: usize,
+    pub every: u32,
+}
+
+/// The byte rate the snapshot interval is chosen to stay under.
+const RATE: usize = 3 * 1024 * 1024;
+
+/// How many states' worth of deltas to keep, and the bounds on that.
+const STATES: usize = 16;
+const BUDGET_MIN: usize = 2 * 1024 * 1024;
+const BUDGET_MAX: usize = 8 * 1024 * 1024;
+
+/// The widest snapshot interval: past this, rewind is too coarse to be worth
+/// having and the answer is to turn it off rather than to stretch it further.
+const EVERY_MAX: u32 = 12;
+
+pub fn plan(state_len: usize) -> Plan {
+    let every = state_len
+        .saturating_mul(60)
+        .div_ceil(RATE.max(1))
+        .clamp(2, EVERY_MAX as usize) as u32;
+    Plan {
+        budget: state_len
+            .saturating_mul(STATES)
+            .clamp(BUDGET_MIN, BUDGET_MAX),
+        every,
+    }
+}
