+    /// Allium's curve, which is the only reason an ADC reading means
+    /// anything. Pinned at the segment edges, where an arithmetic slip shows.
+    #[test]
+    fn the_sar_curve_runs_from_empty_to_full_without_stepping_backwards() {
+        use super::sar::percent_of;
+        assert_eq!(percent_of(600), 100, "a full cell");
+        assert_eq!(percent_of(578), 100, "the top of the curve");
+        assert_eq!(percent_of(528), 50, "the flat middle segment");
+        assert_eq!(percent_of(479), 0, "below the curve is empty");
+        assert_eq!(percent_of(0), 0, "a failed read is not a full battery");
+        // Monotonic apart from the documented 2-point step at 528, which is
+        // Allium's curve and is kept. Anything larger is an arithmetic slip.
+        let mut last = 0u8;
+        for adc in 400..=600 {
+            let p = percent_of(adc);
+            assert!(
+                p + 2 >= last,
+                "{adc} reads {p}, more than 2 below the previous {last}"
+            );
+            assert!(p <= 100);
+            last = p;
+        }
+    }
