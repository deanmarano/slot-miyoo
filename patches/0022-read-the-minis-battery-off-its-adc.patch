 /// vendor ioctls, which is a lot of machinery for the same number.
 const AXP_TOOL: &str = "/customer/app/axp_test";
 
+/// The Miyoo Mini has neither: no `/sys/class/power_supply` and no vendor
+/// tool, because its charge is an ADC reading. Its gauge is the SAR
+/// controller behind `/dev/sar`, two ioctls on it, and a GPIO that says
+/// whether the charger is in.
+///
+/// Both the ioctl numbers and the curve are Allium's, which runs on this
+/// handheld: `crates/common/src/platform/miyoo/battery/miyoo283.rs`. They are
+/// not guessable -- the curve in particular is four straight segments fitted
+/// to this battery, and a reading means nothing without it.
+mod sar {
+    use super::{Battery, Charge};
+    use std::os::unix::io::AsRawFd;
+    use std::path::Path;
+
+    const DEV: &str = "/dev/sar";
+    /// `_IO('a', 0)` and `_IO('a', 1)`: direction none, so the number is just
+    /// the magic and the sequence.
+    const INIT: libc::c_ulong = (b'a' as libc::c_ulong) << 8;
+    const READ_CHANNEL: libc::c_ulong = ((b'a' as libc::c_ulong) << 8) | 1;
+
+    #[repr(C)]
+    struct AdcConfig {
+        channel: i32,
+        value: i32,
+    }
+
+    /// The charger line. Allium exports gpio59 and reads it; a value other
+    /// than zero is the charger in.
+    fn charging() -> Charge {
+        let gpio = Path::new("/sys/devices/gpiochip0/gpio/gpio59/value");
+        if !gpio.is_file() {
+            let _ = std::fs::write("/sys/class/gpio/export", "59");
+            let _ = std::fs::write("/sys/devices/gpiochip0/gpio/gpio59/direction", "in");
+        }
+        match super::read_number(gpio) {
+            Some(0) => Charge::Discharging,
+            Some(_) => Charge::Charging,
+            None => Charge::Unknown,
+        }
+    }
+
+    /// Four straight segments, Allium's, fitted to this cell.
+    ///
+    /// It is not quite continuous: 527 comes out at 51.9% and 528 at 50%, a
+    /// 2-point step down at the join. Kept exactly as Allium has it rather
+    /// than smoothed, because this is a curve fitted to a battery nobody here
+    /// can measure, and a gauge that is 2% out for one ADC count matters less
+    /// than one fitted by guesswork.
+    pub fn percent_of(adc: i32) -> u8 {
+        let p = match adc {
+            578..=i32::MAX => 100.0,
+            528..=577 => (adc - 478) as f64,
+            512..=527 => adc as f64 * 2.125 - 1068.0,
+            480..=511 => adc as f64 * 0.51613 - 243.742,
+            _ => 0.0,
+        };
+        p.clamp(0.0, 100.0) as u8
+    }
+
+    pub fn battery() -> Option<Battery> {
+        if !Path::new(DEV).exists() {
+            return None;
+        }
+        let fd = std::fs::File::open(DEV).ok()?;
+        let mut cfg = AdcConfig {
+            channel: 0,
+            value: 0,
+        };
+        // SAFETY: both are vendor ioctls on a file descriptor we just opened;
+        // the second writes the reading back into `cfg`, which outlives it.
+        let read = unsafe {
+            libc::ioctl(fd.as_raw_fd(), INIT, std::ptr::null::<libc::c_void>());
+            libc::ioctl(fd.as_raw_fd(), READ_CHANNEL, &mut cfg as *mut AdcConfig)
+        };
+        if read < 0 || cfg.value <= 0 {
+            return None;
+        }
+        Some(Battery {
+            percent: percent_of(cfg.value),
+            charge: charging(),
+        })
+    }
+}
