+/// How long `compose` spent inside `CartFaces::sync`.
+///
+/// That call blocks on `recv()` until every face the shelf wants *on screen*
+/// has been built, so a cart scrolling into view before its worker has
+/// finished stalls the frame. It is the obvious suspect for a shelf that
+/// scrolls smoothly and then hitches, and for the gap in notes/hardware.md
+/// between the pacer's `work` of 36-45 ms and `take>swapped` of 11 -- "that
+/// would make most of it waiting rather than work, which has not been proven".
+///
+/// Printed per occurrence rather than averaged, and only past a threshold: an
+/// average would hide exactly the shape being looked for, and the frames that
+/// do not wait are the overwhelming majority.
+pub fn faces_waited(d: std::time::Duration) {
+    const NOTEWORTHY_MS: f64 = 2.0;
+    if !on() {
+        return;
+    }
+    let ms = d.as_secs_f64() * 1e3;
+    if ms >= NOTEWORTHY_MS {
+        eprintln!("slot: faces: compose waited {ms:.1} ms for a cart face");
+    }
+}
+
 pub fn tracing() -> bool {
     on()
 }
