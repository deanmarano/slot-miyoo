+    /// Which Miyoo this is, told apart by what the hardware has rather than
+    /// by a model string none of them carries.
+    ///
+    /// The same three-way split Allium makes in its boot hook, and the same
+    /// one the battery already relies on: the Flip is the one with a second
+    /// input node (its hall sensor), the Mini Plus is the one with the vendor
+    /// battery tool, and the Mini is the one left -- the one whose charge is
+    /// an ADC. A handheld that answers none of them gets the family name, not
+    /// a guess.
+    fn model(&self) -> String {
+        let has = |p: &str| Path::new(p).exists();
+        match (has("/dev/input/event1"), has(AXP_TOOL), has("/dev/sar")) {
+            (true, _, _) => "MIYOO MINI FLIP",
+            (_, true, _) => "MIYOO MINI PLUS",
+            (_, _, true) => "MIYOO MINI",
+            _ => "MIYOO",
+        }
+        .to_string()
+    }
+
