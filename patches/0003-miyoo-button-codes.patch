+/// Ask the scheduler to favour this thread.
+///
+/// The input readers do almost nothing but block on a read, yet on a two-core
+/// device with a render loop and an emulator thread they can be left unscheduled
+/// for over a second: the trace shows repeats arriving every 50 ms and then a
+/// 1.28 s gap with twenty-two of them delivered at once. Gestures are timed from
+/// when events are *processed*, so a stall that falls between a press and its
+/// release turns a tap into a 250-1000 ms press, which is slot's dead zone
+/// between "tap" and "hold" -- the button then appears to do nothing at all.
+///
+/// Niceness is the portable lever here; it needs no privileges to lower within
+/// the default range and cannot hurt if the kernel ignores it.
+fn favour_this_thread() {
+    const PRIO_PROCESS: libc::c_int = 0;
+    // SAFETY: setpriority on the calling thread, 0 meaning "me".
+    unsafe {
+        libc::setpriority(PRIO_PROCESS as u32, 0, -10);
+    }
+}
