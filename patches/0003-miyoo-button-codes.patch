+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// The boot this exists for: the sensor says closed with the lid open,
+    /// and slot must not doze on it.
+    #[test]
+    fn a_stale_closed_reading_at_boot_is_ignored() {
+        let (mut armed, mut last) = (false, None);
+        for _ in 0..5 {
+            assert!(lid_event(&mut armed, &mut last, true).is_none());
+        }
+        assert!(!armed, "a closed reading should not arm the sensor");
+    }
+
+    /// And once it has told the truth once, every cycle is slot's.
+    #[test]
+    fn the_lid_is_followed_after_it_first_reads_open() {
+        let (mut armed, mut last) = (false, None);
+        assert!(lid_event(&mut armed, &mut last, true).is_none());
+        assert_eq!(
+            lid_event(&mut armed, &mut last, false),
+            Some(RawEvent::Up(Btn::Lid)),
+            "the first open reading is the one that arms it, and it is real"
+        );
+        assert_eq!(lid_event(&mut armed, &mut last, false), None, "no change");
+        assert_eq!(
+            lid_event(&mut armed, &mut last, true),
+            Some(RawEvent::Down(Btn::Lid)),
+            "a close after arming is slot's to act on"
+        );
+        assert_eq!(
+            lid_event(&mut armed, &mut last, false),
+            Some(RawEvent::Up(Btn::Lid))
+        );
+    }
+}
