+/// `retro_system_info`, for the one field slot needs from it.
+///
+/// `need_fullpath` says the core opens the file itself, in which case the
+/// frontend must not read it: gpSP sets it, and slot was reading every ROM
+/// into its own memory and holding it for the life of the game anyway. A
+/// 32 MB cart then cost 32 MB that nothing ever looked at, on a handheld with
+/// about 40 MB free, and Mother 3 could not be loaded at all.
+#[repr(C)]
+pub struct SystemInfo {
+    pub library_name: *const std::ffi::c_char,
+    pub library_version: *const std::ffi::c_char,
+    pub valid_extensions: *const std::ffi::c_char,
+    pub need_fullpath: bool,
+    pub block_extract: bool,
+}
+
+impl Default for SystemInfo {
+    fn default() -> Self {
+        SystemInfo {
+            library_name: std::ptr::null(),
+            library_version: std::ptr::null(),
+            valid_extensions: std::ptr::null(),
+            need_fullpath: false,
+            block_extract: false,
+        }
+    }
+}
